// Shared metadata for the executables and input service.
#ifndef ATYPOI_FILETYPE
#define ATYPOI_FILETYPE VFT_APP
#endif
1 VERSIONINFO
FILEVERSION 0,1,4,0
PRODUCTVERSION 0,1,4,0
FILEFLAGSMASK 0x3fL
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE ATYPOI_FILETYPE
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Atypoi contributors\0"
      VALUE "FileDescription", "Atypoi - Korean and English input\0"
      VALUE "FileVersion", "0.1.4-dev\0"
      VALUE "ProductName", "Atypoi\0"
      VALUE "ProductVersion", "0.1.4-dev\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 Atypoi contributors\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
